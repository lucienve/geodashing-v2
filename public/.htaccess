# Geodashing Global Security Overrides

# 1. Deny access to all sensitive configuration files across the entire application tree natively
<FilesMatch "\.(env|ini|json|lock|md|log)$">
    Require all denied
</FilesMatch>

# 2. Routing Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route sitemap.xml to dynamic PHP generation service
    RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
</IfModule>

# 3. Disable directory browsing globally (preventing users from seeing lists of files)
Options -Indexes

# 4. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=2592000"
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header set Content-Security-Policy "frame-ancestors 'self';"
</IfModule>
