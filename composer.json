{
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "require": {
        "php": "^8.5",
        "google/cloud-storage": "^2.6",
        "ext-gd": "*",
        "google/apiclient": "^2.20",
        "symfony/mime": "^8.1",
        "egulias/email-validator": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/",
            "App\\Services\\": "backend/services/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "backend/tests/"
        }
    },
    "scripts": {
        "test": "phpunit backend/tests/",
        "lint:syntax": "find backend/ public/api/ e2e/ -type f -name '*.php' -exec php -l {} + > /dev/null",
        "lint": "phpcs --standard=phpcs.xml backend/ public/api/ e2e/router.php",
        "lint:fix": "phpcbf --standard=phpcs.xml backend/ public/api/ e2e/router.php"
    }
}
