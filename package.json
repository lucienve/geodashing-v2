{
  "name": "geodashing-v2",
  "version": "1.0.0",
  "description": "A reimplementation of the classic GeoDashing game by Scout",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint public/js/**/*.js e2e/**/*.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#vendor\" \"#.venv\" \"#test-results\" \"#playwright-report\" \"#e2e-results\"",
    "format": "prettier --ignore-path .gitignore --write --single-quote \"**/*.md\" \"public/js/**/*.js\" \"e2e/**/*.js\" \"eslint.config.mjs\"",
    "format:check": "prettier --ignore-path .gitignore --check --single-quote \"**/*.md\" \"public/js/**/*.js\" \"e2e/**/*.js\" \"eslint.config.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucienve/geodashing-v2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lucienve/geodashing-v2/issues"
  },
  "homepage": "https://github.com/lucienve/geodashing-v2#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.9.10"
  }
}
