[config]
; Path to the uv binary if installed in a non-standard location
UV_BIN = "/path/to/.local/bin/uv"

[database]
DB_HOST = "127.0.0.1"
DB_PORT = "3306"
DB_NAME = "geodashing"
DB_USER = "geodashing"
DB_PASS = "geodashing"

[mail]
GOOGLE_APPLICATION_CREDENTIALS = "backend/gcp-credentials.json"
MAILING_LIST_ADDRESS = "tracker@geodashing.org"
GOOGLE_GROUP_ADMIN_USER = "tracker@geodashing.org"
GOOGLE_GROUP_KEY = "dashers@geodashing.org"

[google]
GOOGLE_MAPS_API_KEY = "AIzaSy..."

[gemini]
GEMINI_API_KEY = "AIzaSy..."
GEMINI_MODEL = "gemini-4-argon"
GEMINI_EVAL_MODEL = "gemini-4-argon"
GEMINI_THINKING_LEVEL = "medium"
GEMINI_PROJECT_ID = "your-gcp-project-id"

[reroll]
REROLL_ENABLED = true
REROLL_MAX_RADIUS_KM = 10.0
REROLL_MAX_PER_PLAYER = 3
REROLL_NOTIFICATION_EMAIL = "tracker@geodashing.org"

[game]
DEFAULT_DASHPOINT_COUNT = 35000
TIMEZONE = "America/New_York"
SEND_TURNOVER_ANNOUNCEMENT = true

[tags]
; Enable private dashpoint tagging globally
TAGS_ENABLED = false
; Comma-separated list of usernames allowed to access tagging when TAGS_ENABLED = false
TAGS_ALLOWLIST = ""

[gcs]
; Dedicated GCS bucket for global road and map datasets
GCS_MAP_DATA_BUCKET_NAME = "geodashing-v2-map-data"
; Local path to cached road GeoPackage file (e.g. data/world_drivable_roads.gpkg or /mnt/geodashing-data/world_drivable_roads.gpkg)
ROADS_GPKG_PATH = "data/world_drivable_roads.gpkg"
