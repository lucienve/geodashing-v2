FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

# Install system utilities and GIS tooling required for OSM processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    aria2 \
    ca-certificates \
    curl \
    gdal-bin \
    osmium-tool \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_DEV=1

# Pre-install locked dependencies for build layer caching
COPY .python-version pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy application source code required for road preparation
COPY backend/__init__.py backend/
COPY backend/scripts/__init__.py backend/scripts/prepare_roads.py backend/scripts/

ENV UV_NO_SYNC=1

ENTRYPOINT ["uv", "run", "--no-sync", "--no-dev", "python", "-m", "backend.scripts.prepare_roads"]
